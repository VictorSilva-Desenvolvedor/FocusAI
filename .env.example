# Copie para .env.local e preencha. `.env.local` não é versionado.
#
# Só entra aqui o que pode ser lido por qualquer visitante do site publicado:
# tudo com prefixo VITE_ é embutido no pacote final. Segredo de servidor mora em
# .secrets/ e nunca ganha esse prefixo (API-R01).

VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
