        "id": "871f2b8c-a8f4-422a-beb5-39cdc677a195",
        "name": "Extrair campos",
        "parameters": {
          "jsCode": "/*\n * Só extração: acha o campo pelo tipo e pelo nome do campo oculto. Nenhuma\n * decisão de negócio mora aqui — tese, UF, deduplicação e preço são do banco.\n */\nconst corpo = $json.body ?? $json;\nconst dados = corpo.data ?? {};\nconst campos = dados.fields ?? [];\n\nconst porTipo = (tipo) => campos.find((c) => c.type === tipo)?.value ?? null;\nconst oculto = (nome) =>\n  campos.find((c) => c.label === nome || c.key === nome)?.value ?? null;\n\nreturn [{\n  json: {\n    respondenteId: dados.respondentId ?? null,\n    formularioId: dados.formId ?? null,\n    nome: porTipo('INPUT_TEXT'),\n    telefone: porTipo('INPUT_PHONE_NUMBER'),\n    fbp: oculto('fbp'),\n    fbc: oculto('fbc'),\n    fbclid: oculto('fbclid'),\n    pagina: oculto('pagina'),\n    eventoId: oculto('evento_id'),\n  },\n}];"
        },
        "position": [
          220,
          0
        ],
        "type": "n8n-nodes-base.code",
        "typeVersion": 2
      },
